<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Variante SANDBOXÉE — à n'utiliser qu'en connaissance de cause.

  Limites structurelles : le processus enfant `claude` HÉRITE du sandbox.
  Même avec les exceptions ci-dessous, certaines fonctions du CLI resteront
  dégradées (accès disque arbitraire des outils, exécution de commandes…).
  L'exception « temporary-exception » est par ailleurs refusée en pratique
  lors d'une review App Store. Pour un outil développeur, préférez le fichier
  ClaudeCompanion.entitlements (non sandboxé + notarisation Developer ID).
-->
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>

	<!-- Le CLI communique avec l'API Anthropic. -->
	<key>com.apple.security.network.client</key>
	<true/>

	<!-- Dossiers choisis via NSOpenPanel / fileImporter (lecture-écriture).
	     Pour CONSERVER l'accès après relance, persistez un security-scoped
	     bookmark du dossier de projet :
	       url.bookmarkData(options: .withSecurityScope, …)
	     puis, au lancement :
	       URL(resolvingBookmarkData: …, options: .withSecurityScope)
	       url.startAccessingSecurityScopedResource()
	     (ChatViewModel.setProjectDirectory appelle déjà
	      startAccessingSecurityScopedResource sur l'URL fraîche.) -->
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>

	<!-- ~/.claude : sessions JSONL, configuration et identifiants du CLI. -->
	<key>com.apple.security.temporary-exception.files.home-relative-path.read-write</key>
	<array>
		<string>/.claude/</string>
	</array>
</dict>
</plist>
